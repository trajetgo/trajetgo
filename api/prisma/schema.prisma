generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PASSENGER
  AGENCY_AGENT
  CONTROLLER
  COMPANY_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BusStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum BusAmenity {
  AIR_CONDITIONING
  WIFI
  USB_CHARGING
  POWER_OUTLET
  TOILET
  TV
  RECLINING_SEATS
  READING_LIGHT
  LUGGAGE_SPACE
}

enum TripStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  ARRIVED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  BOARDED
  COMPLETED
  NO_SHOW
}

enum VerificationPurpose {
  VERIFY_EMAIL
  VERIFY_PHONE
  LOGIN
  RESET_PASSWORD
  CHANGE_EMAIL
  CHANGE_PHONE
  VERIFY_ESTABLISHMENT_PHONE
}

enum VerificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationCategory {
  BOOKING
  PAYMENT
  TRIP
  BOARDING
  ACCOUNT
  SECURITY
  SYSTEM
  MARKETING
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationProvider {
  INTERNAL
  WEB_PUSH
  ESMS_AFRICA
  SMTP
}

enum PushApplication {
  PASSENGER
  COMPANY
  AGENCY
  CONTROLLER
  ADMIN
}

model User {
  id            String     @id @default(cuid())
  firstName     String
  lastName      String
  fullName      String?
  avatarUrl     String?
  email           String?   @unique
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  phone           String?   @unique
  phoneVerified   Boolean   @default(false)
  phoneVerifiedAt DateTime? 
  password      PasswordCredential?
  role          UserRole   @default(PASSENGER)
  status        UserStatus @default(ACTIVE)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  sessions      Session[]
  auditLogs     AuditLog[]
  verifications Verification[]

  loginAttempts LoginAttempt[]
 
  notifications Notification[]
  pushSubscriptions PushSubscription[]

  bookings Booking[]
  sentInvitations CompanyInvitation[]
  controlledBoardings Boarding[] @relation("BoardingController")

  lastLoginAt DateTime?  
  createdAt   DateTime   @default(now()) 
  updatedAt   DateTime   @updatedAt 
  deletedAt   DateTime?

  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([companyId])
  @@index([agencyId])
  @@map("users")
}

model PasswordCredential {
  userId     String   @id 
  hash       String
  // "argon2id" pour les nouveaux comptes ; valeur d'origine (ex. "bcrypt")
  // pour les comptes importés d'AdsCity & co. Rehash à la prochaine connexion.
  algorithm  String   @default("argon2id")
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("password_credentials")
}

model PushSubscription {
  id String @id @default(cuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique

  p256dh String
  auth String

  application PushApplication

  deviceLabel String?
  userAgent String?

  expiresAt DateTime?

  lastUsedAt DateTime?
  revokedAt DateTime?

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, application])
  @@index([revokedAt])
  @@index([expiresAt])
  @@map("push_subscriptions")
}

model Notification {
  id String @id @default(cuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  category NotificationCategory
  eventKey String

  title String
  body String

  data Json?
  actionUrl String?

  priority NotificationPriority @default(NORMAL)

  deduplicationKey String?

  readAt DateTime?
  archivedAt DateTime?
  expiresAt DateTime?

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deduplicationKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([category])
  @@index([eventKey])
  @@index([expiresAt])
  @@map("notifications")
}

model NotificationDelivery {
  id String @id @default(cuid())

  notificationId String
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  provider NotificationProvider

  status NotificationDeliveryStatus @default(PENDING)

  // Destination SMS ou e-mail.
  // Pour le Web Push, utiliser pushSubscriptionId.
  destination String?

  pushSubscriptionId String?
  pushSubscription PushSubscription? @relation(fields: [pushSubscriptionId], references: [id], onDelete: SetNull)

  providerMessageId String?
  idempotencyKey String? @unique

  attemptCount Int @default(0)
  maxAttempts Int @default(3)

  nextAttemptAt DateTime?
  lastAttemptAt DateTime?

  sentAt DateTime?
  deliveredAt DateTime?
  failedAt DateTime?

  errorCode String?
  errorMessage String?

  providerResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([notificationId])
  @@index([status, nextAttemptAt])
  @@index([pushSubscriptionId])
  @@index([provider, providerMessageId])
  @@index([channel, status])
  @@map("notification_delivery")
}

// Codes à usage unique (OTP SMS/WhatsApp/e-mail, liens de réinitialisation).
// On ne stocke jamais le code en clair, uniquement son hash.
model Verification {
  id         String              @id @default(cuid())
  userId     String?  
  establishmentId String?          
  purpose    VerificationPurpose
  channel    VerificationChannel
  target     String // e-mail ou téléphone visé
  codeHash   String              
  attempts   Int                 @default(0)
  maxAttempts Int                @default(5) 
  expiresAt  DateTime           
  consumedAt DateTime?           
  createdAt  DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose])
  @@index([codeHash, purpose]) 
  @@index([expiresAt])
  @@map("verifications")
}

model LoginAttempt {
  id          String   @id @default(cuid())

  // Identifiant tenté (email ou téléphone, normalisé) — pas userId,
  // car on veut aussi tracer les tentatives sur des comptes inexistants.
  identifier  String

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  success     Boolean  @default(false)
  reason      String?  // "bad_password" | "unknown_account" | "suspended" | ...

  ip          String?
  userAgent   String?
  country     String?  // rempli si géo-IP activée

  createdAt   DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// ----------------------------------------------------------------------------
// Session SSO (le cookie partagé)
// ----------------------------------------------------------------------------
// Un cookie `xid_session` (HttpOnly, Secure, SameSite=Lax, Domain=.xenady.com)
// contient un jeton aléatoire. Seul son hash SHA-256 est stocké ici.
// Il est lu par id.xenady.com ; les apps ne s'appuient que sur OIDC.

model Session {
  id         String   @id @default(cuid()) 
  userId     String  
  tokenHash  String   @unique 

  // Niveau d'authentification de la session (claims OIDC acr / amr / auth_time)
  authTime   DateTime
  amr        String[] // ex. ["pwd"], ["otp"], ["pwd","totp"], ["google"]
  mfaLevel   Int      @default(0) 

  // Appareil
  ip         String?
  userAgent  String?  
  deviceName String?  
  os         String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now()) 
  expiresAt  DateTime 
  revokedAt  DateTime?

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Company {
  id String @id @default(cuid())

  name String @unique
  legalName String?

  // Informations légales
  registrationNumber String? @unique // rccm
  taxId String? @unique              // idu

  // Contact
  email String? @unique
  phone String
  website String?

  // Siège
  address String?
  cityId String?
  city City? @relation(fields: [cityId], references: [id])

  // Logo
  logo String?

  status CompanyStatus @default(ACTIVE)

  users       User[]
  buses       Bus[]
  drivers     Driver[] 
  routes      Route[]
  agencies    Agency[]
  schedules   Schedule[]

  subscription Subscription?
  tgtlIntegration TgtlIntegration?
  invitations CompanyInvitation[]

  externalReferences ExternalReference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
  @@index([cityId])
  @@map("companies")
}

/* =========================================================
   GÉOGRAPHIE
   ========================================================= */

model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique              // ISO 3166-1 alpha-2 : "CI", "SN", "GH"
  phoneCode String?                       // "+225", "+221"
  currency  String?  @default("XOF")      // "XOF", "EUR", "USD"

  active    Boolean  @default(true)

  regions   Region[]
  cities    City[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@index([active])
  @@map("countries")
}

model Region {
  id        String   @id @default(cuid())
  name      String
  code      String?

  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  cities    City[]

  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, name])
  @@index([countryId])
  @@index([active])
  @@map("regions")
}

model City {
  id        String   @id @default(cuid())
  name      String
  code      String?

  latitude  Float?
  longitude Float?

  regionId  String?
  region    Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)

  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  // Relations métier
  originRoutes      Route[] @relation("RouteOrigin")
  destinationRoutes Route[] @relation("RouteDestination")
  locations         Location[]

  companies Company[]
  agencies  Agency[]

  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, name])
  @@index([name])
  @@index([regionId])
  @@index([countryId])
  @@index([active])
  @@map("cities")
}

model Location {
  id        String   @id @default(cuid())
  name      String

  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  address   String?
  latitude  Float?
  longitude Float?

  active    Boolean  @default(true)

  departureTrips Trip[] @relation("TripDepartureLocation")
  arrivalTrips   Trip[] @relation("TripArrivalLocation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId])
  @@index([active])
  @@map("locations")
}

model Agency {
  id String @id @default(cuid())

  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cityId String?
  city City? @relation(fields: [cityId], references: [id])

  name String
  address String?

  phone String?
  email String?

  status AgencyStatus @default(ACTIVE)

  users User[]
  bookings Booking[]

  invitations CompanyInvitation[]

  departureTrips Trip[] @relation("TripDepartureAgency")
  arrivalTrips   Trip[] @relation("TripArrivalAgency")

  departureSchedules Schedule[] @relation("ScheduleDeparture")
  arrivalSchedules   Schedule[] @relation("ScheduleArrival")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([cityId])
  @@index([status])
  @@index([name])
  @@map("agencies")
}

enum AgencyStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

model Route {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  originCityId      String
  destinationCityId String

  originCity      City @relation("RouteOrigin", fields: [originCityId], references: [id])
  destinationCity City @relation("RouteDestination", fields: [destinationCityId], references: [id])

  basePrice   Int
  distanceKm Float
  durationMin Int

  active Boolean @default(true)

  trips Trip[]
  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([originCityId])
  @@index([destinationCityId])
  @@index([active])

  @@unique([companyId, originCityId, destinationCityId])
  @@map("routes")
}

model Bus {
  id String @id @default(cuid())

  // ─────────────────────────────────────────
  // Propriétaire
  // ─────────────────────────────────────────

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // ─────────────────────────────────────────
  // Identification
  // ─────────────────────────────────────────

  registrationNumber String

  fleetNumber String?
  name        String?

  // ─────────────────────────────────────────
  // Constructeur
  // ─────────────────────────────────────────

  brand String?
  model String?

  year Int?

  // ─────────────────────────────────────────
  // Caractéristiques
  // ─────────────────────────────────────────

  capacity Int

  busType BusType @default(COACH)

  // ─────────────────────────────────────────
  // Équipements
  // ─────────────────────────────────────────

  amenities BusAmenity[]

  // ─────────────────────────────────────────
  // Exploitation
  // ─────────────────────────────────────────

  status BusStatus @default(ACTIVE)

  scheduleDepartures ScheduleDeparture[]
  trips     Trip[]

  // ─────────────────────────────────────────
  // Configuration sièges
  // ─────────────────────────────────────────

  seatLayout SeatLayout?

  // ─────────────────────────────────────────
  // Dates
  // ─────────────────────────────────────────

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─────────────────────────────────────────
  // Index
  // ─────────────────────────────────────────

  @@unique([companyId, registrationNumber])
  @@unique([companyId, fleetNumber])

  @@index([companyId])
  @@index([registrationNumber])
  @@index([brand])
  @@index([model])
  @@index([status])
  @@map("buses")
}

enum BusType {
  COACH
  MINIBUS
  BUS
  VAN
  OTHER
}

model Driver {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Identité
  firstName String
  lastName  String
  fullName  String?

  phone     String?
  email     String?
  licenseNumber String?   // numéro de permis de conduire
  licenseCategory String? // "C", "D", "E"…

  // Statut
  status DriverStatus @default(ACTIVE)

  // Relations
  trips     Trip[]
  departures ScheduleDeparture[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@unique([companyId, licenseNumber])
  @@map("drivers")
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE    // en congé
  SUSPENDED   // suspendu
}

model Trip {
  id String @id @default(cuid())

  routeId String
  route   Route @relation(fields: [routeId], references: [id])

  busId String
  bus   Bus @relation(fields: [busId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  scheduleId String?
  schedule Schedule? @relation(fields: [scheduleId], references: [id])

  scheduleDepartureId String?
  scheduleDeparture   ScheduleDeparture? @relation(fields: [scheduleDepartureId], references: [id], onDelete: SetNull)

  departureLocationId String?
  arrivalLocationId   String?

  departureLocation Location? @relation("TripDepartureLocation", fields: [departureLocationId], references: [id])
  arrivalLocation Location? @relation("TripArrivalLocation", fields: [arrivalLocationId], references: [id])

  departureAgencyId String
  arrivalAgencyId   String

  departureAgency Agency @relation("TripDepartureAgency", fields: [departureAgencyId],references: [id])

  arrivalAgency Agency @relation("TripArrivalAgency", fields: [arrivalAgencyId], references: [id])

  departureAt DateTime
  arrivalAt   DateTime?

  price  Int
  status TripStatus @default(SCHEDULED)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, departureAt, busId])
  @@index([routeId])
  @@index([busId])
  @@index([driverId])
  @@index([departureAt])
  @@index([status])
  @@index([departureLocationId])
  @@index([arrivalLocationId])
  @@index([departureAgencyId])
  @@index([arrivalAgencyId])
  @@map("trips")
}

model Booking {
  id String @id @default(cuid())

  userId String
  tripId String
  seatId String

  agencyId  String?

  status BookingStatus @default(PENDING)

  amount Int

  user User @relation(fields: [userId], references: [id])
  trip Trip @relation(fields: [tripId], references: [id])
  seat Seat @relation(fields: [seatId], references: [id], onDelete: SetNull)
  agency    Agency? @relation(fields: [agencyId], references: [id])

  payment Payment?
  ticket  Ticket?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripId, seatId])
  @@index([userId])
  @@index([tripId])
  @@index([seatId])
  @@index([agencyId])
  @@index([status])
  @@map("bookings")
}

model SeatLayout {
  id String @id @default(cuid())

  busId String
  bus   Bus @relation(fields: [busId], references: [id])

  name String

  type SeatLayoutType

  rows    Int
  columns Int

  seats Seat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([busId])
  @@index([busId])
  @@map("seat_layout")
}

enum SeatLayoutType {
  TWO_PLUS_TWO
  TWO_PLUS_ONE
  ONE_PLUS_TWO
  CUSTOM
}

model Seat {
  id String @id @default(cuid())

  layoutId String
  layout   SeatLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  number   String
  row      Int
  column   Int
  position SeatPosition?

  status SeatStatus @default(ACTIVE)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([layoutId, number])
  @@unique([layoutId, row, column])
  @@index([layoutId])
  @@index([status])
  @@map("seats")
}

enum SeatPosition {
  WINDOW
  AISLE
  MIDDLE
}

enum SeatStatus {
  ACTIVE
  INACTIVE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  ORANGE_MONEY
  MTN_MOBILE_MONEY
  MOOV_MONEY
  WAVE
  CARD
  CASH
}

model Payment {
  id String @id @default(cuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount   Int
  currency String @default("XOF")

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  transactionId    String?
  providerReference String?

  paidAt    DateTime?
  expiresAt DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([transactionId])
  @@index([providerReference])
  @@index([expiresAt])
  @@map("payments")
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
}

model Ticket {
  id String @id @default(cuid())

  bookingId String @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  ticketNumber String @unique
  qrCode       String @unique

  status TicketStatus @default(ACTIVE)

  boarding Boarding?

  issuedAt   DateTime @default(now())
  usedAt     DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketNumber])
  @@index([qrCode])
  @@index([status])
  @@map("tickets")
}

enum BoardingStatus {
  PENDING
  BOARDED
  REJECTED
  CANCELLED
}

model Boarding {
  id String @id @default(cuid())

  ticketId String @unique
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  controllerId String?
  controller User? @relation("BoardingController", fields: [controllerId], references: [id])

  status BoardingStatus @default(PENDING)

  scannedAt DateTime?
  boardedAt DateTime?

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([controllerId])
  @@index([status])
  @@index([scannedAt])
  @@map("boardings")
}

enum NotificationType {
  BOOKING
  PAYMENT
  TICKET
  TRIP
  BOARDING
  CANCELLATION
  REFUND
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Subscription {
  id String @id @default(cuid())

  companyId String @unique
  company Company @relation(fields: [companyId], references: [id])

  planId String
  plan Plan @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime
  currentPeriodEnd DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("subscriptions")
}

model Plan {
  id String @id @default(cuid())

  name String
  monthlyPrice Int

  includedSeats Int

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("plans")
}

model CompanyInvitation {
  id String @id @default(cuid())

  companyId String
  agencyId String?

  email String?
  phone String

  role UserRole

  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?

  invitedById String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  agency Agency? @relation(fields: [agencyId], references: [id])

  invitedBy User @relation(fields: [invitedById], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([agencyId])
  @@index([invitedById])
  @@index([phone])
  @@index([email])
  @@index([expiresAt])
  @@map("company_invitation")
}


model Schedule {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  routeId String
  route   Route @relation(fields: [routeId], references: [id])

  departureAgencyId String
  arrivalAgencyId   String

  departureAgency Agency @relation("ScheduleDeparture", fields: [departureAgencyId], references: [id])
  arrivalAgency   Agency @relation("ScheduleArrival", fields: [arrivalAgencyId], references: [id])

  price   Int
  durationMinutes Int?

  /* ---------------- Période ---------------- */

  startDate DateTime
  endDate   DateTime?

  daysOfWeek DayOfWeek[]

  /* ---------------- Départs ---------------- */

  departures ScheduleDeparture[]

 /* ---------------- Méta ---------------- */

  active    Boolean @default(true)
  autoGenerate Boolean @default(true)

  trips Trip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, routeId, departureAgencyId, arrivalAgencyId, startDate])
  @@index([companyId])
  @@index([routeId])
  @@index([active])
  @@map("schedules")
}

model ScheduleDeparture {
  id String @id @default(cuid())

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  busId String
  bus   Bus @relation(fields: [busId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  departureTime String    // "08:00"

  trips Trip[]

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, departureTime, busId])
  @@index([scheduleId])
  @@index([busId])
  @@index([driverId])
  @@map("schedule_departures")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model TgtlIntegration {
  id        String   @id @default(cuid())

  companyId String   @unique
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Dernière opération réussie
  lastSyncAt        DateTime?
  lastSyncType      String?   // "import" | "export" | "sync"
  lastSyncVersion   String?   // ex. "1.2"

  // Compteurs de la dernière importation
  resourcesImported Int       @default(0)
  agenciesCount     Int       @default(0)
  busesCount        Int       @default(0)
  routesCount       Int       @default(0)
  schedulesCount    Int       @default(0)
  staffCount        Int       @default(0)
  driversCount      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tgtl_integrations")
}

enum ExternalEntityType {
  COMPANY
  COUNTRY
  REGION
  CITY
  AGENCY
  BUS
  SEAT
  DRIVER
  ROUTE
  SCHEDULE
  SCHEDULE_DEPARTURE
  USER
}

model ExternalReference {
  id         String             @id @default(cuid())

  companyId  String
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  source     String             @default("TGTL")
  entityType ExternalEntityType
  externalId String
  entityId   String

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([companyId, source, entityType, externalId])
  @@unique([companyId, source, entityType, entityId])
  @@index([companyId, entityType, entityId])
  @@map("external_references")
}

// ----------------------------------------------------------------------------
// Journal de sécurité
// ----------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String? 
  clientId  String? 
  event     String // "login.success", "login.failed", "password.reset", "session.revoked"...
  ip        String?
  userAgent String? 
  device    String?
  os        String?
  browser   String?
  metadata  Json?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@map("audit_logs")
}