<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Vérifiez votre adresse e-mail</title>

    <!--[if mso]>
    <style type="text/css">
        body, table, td { font-family: Arial, sans-serif !important; }
    </style>
    <![endif]-->

    <style type="text/css">
        /* Reset */
        body,
        table,
        td,
        a {
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table,
        td {
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        img {
            -ms-interpolation-mode: bicubic;
            border: 0;
            height: auto;
            line-height: 100%;
            outline: none;
            text-decoration: none;
        }

        body {
            margin: 0;
            padding: 0;
            width: 100% !important;
            height: 100% !important;
            background-color: #f3f4f6;
        }

        a {
            color: #0b3b60;
        }

        /* Responsive */
        @media screen and (max-width: 600px) {
            .email-container {
                width: 100% !important;
            }

            .email-padding {
                padding: 24px 20px !important;
            }

            .email-title {
                font-size: 20px !important;
            }

            .email-button {
                width: 100% !important;
                display: block !important;
            }

            .email-button a {
                display: block !important;
                padding: 14px 20px !important;
            }

            .email-url {
                font-size: 11px !important;
                word-break: break-all !important;
            }
        }
    </style>
</head>

<body style="margin: 0; padding: 0; background-color: #f3f4f6;">

    <!-- Préheader (texte affiché dans la boîte de réception, avant l'ouverture) -->
    <div
        style="display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #f3f4f6;">
        Confirmez votre adresse e-mail pour activer votre compte Trajet Go.
        Ce lien expire dans <%= expiresInHours %> heures.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color: #f3f4f6;">
        <tr>
            <td align="center" style="padding: 32px 16px;">

                <table role="presentation" class="email-container" width="560" cellpadding="0" cellspacing="0"
                    border="0"
                    style="width: 560px; max-width: 560px; background-color: #ffffff; border-radius: 14px; overflow: hidden;">

                    <!-- En-tête -->
                    <tr>
                        <td style="background-color: #0b3b60; padding: 24px 32px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td
                                        style="font-family: Arial, sans-serif; font-size: 18px; font-weight: bold; color: #ffffff;">
                                        Trajet Go
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Contenu -->
                    <tr>
                        <td class="email-padding" style="padding: 36px 32px;">

                            <h1 class="email-title"
                                style="margin: 0 0 16px; font-family: Arial, sans-serif; font-size: 22px; line-height: 1.3; font-weight: bold; color: #111827;">
                                Bonjour <%= fullName || "cher voyageur" %>,
                            </h1>

                            <p
                                style="margin: 0 0 16px; font-family: Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #374151;">
                                Merci de votre inscription sur <strong>Trajet Go</strong>.
                                Pour activer votre compte et commencer à réserver vos trajets,
                                il ne reste plus qu'à confirmer votre adresse e-mail.
                            </p>

                            <p
                                style="margin: 0 0 28px; font-family: Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #374151;">
                                Cliquez sur le bouton ci-dessous :
                            </p>

                            <!-- Bouton -->
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                                style="margin: 0 0 28px;">
                                <tr>
                                    <td align="center" style="border-radius: 10px; background-color: #0b3b60;">
                                        <a href="<%= verificationUrl %>" target="_blank" rel="noopener noreferrer"
                                            class="email-button"
                                            style="display: inline-block; padding: 14px 32px; font-family: Arial, sans-serif; font-size: 15px; font-weight: bold; color: #ffffff; text-decoration: none; border-radius: 10px;">
                                            Vérifier mon adresse e-mail
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <!-- Lien de secours -->
                            <p
                                style="margin: 0 0 8px; font-family: Arial, sans-serif; font-size: 13px; line-height: 1.5; color: #6b7280;">
                                Si le bouton ne fonctionne pas, copiez-collez ce lien dans votre navigateur :
                            </p>

                            <p class="email-url"
                                style="margin: 0 0 24px; font-family: Arial, sans-serif; font-size: 12px; line-height: 1.5; color: #0b3b60; word-break: break-all;">
                                <%= verificationUrl %>
                            </p>

                            <!-- Encart expiration -->
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="margin: 0 0 8px;">
                                <tr>
                                    <td
                                        style="padding: 14px 16px; background-color: #fef3c7; border-left: 3px solid #f59e0b; border-radius: 6px; font-family: Arial, sans-serif; font-size: 13px; line-height: 1.5; color: #92400e;">
                                        ⏱ Ce lien expire dans <strong>
                                            <%= expiresInHours %> heures
                                        </strong>.
                                        Passé ce délai, vous devrez en demander un nouveau.
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- Séparateur -->
                    <tr>
                        <td style="padding: 0 32px;">
                            <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 0;" />
                        </td>
                    </tr>

                    <!-- Note de sécurité -->
                    <tr>
                        <td class="email-padding" style="padding: 24px 32px;">
                            <p
                                style="margin: 0 0 10px; font-family: Arial, sans-serif; font-size: 13px; line-height: 1.6; color: #6b7280;">
                                <strong style="color: #374151;">Vous n'êtes pas à l'origine de cette inscription
                                    ?</strong>
                            </p>

                            <p
                                style="margin: 0; font-family: Arial, sans-serif; font-size: 13px; line-height: 1.6; color: #6b7280;">
                                Ignorez simplement cet email : aucun compte ne sera activé tant que
                                vous n'aurez pas cliqué sur le lien. Si vous recevez plusieurs messages
                                de ce type, contactez notre support à
                                <a href="mailto:support@trajetgo.org"
                                    style="color: #0b3b60; text-decoration: underline;">support@trajetgo.org</a>.
                            </p>
                        </td>
                    </tr>

                    <!-- Pied de page -->
                    <tr>
                        <td
                            style="padding: 20px 32px; background-color: #f9fafb; border-top: 1px solid #e5e7eb; font-family: Arial, sans-serif; font-size: 12px; line-height: 1.6; color: #9ca3af; text-align: center;">
                            <p style="margin: 0 0 4px;">
                                © <%= new Date().getFullYear() %> Trajet Go — Abidjan, Côte d'Ivoire
                            </p>
                            <p style="margin: 0;">
                                Cet email a été envoyé automatiquement, merci de ne pas y répondre.
                            </p>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>