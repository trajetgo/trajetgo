<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Vérifiez votre adresse e-mail — Trajet Go</title>

    <!-- Inter est la police de marque. Les clients mail qui ne chargent pas les polices web
       utiliseront Segoe UI / Arial en remplacement. -->
    <style type="text/css">
        @import url('https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap');

        :root {
            --font-heading: 'Ubuntu', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            --font-body: 'Roboto Mono', SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        }

        body,
        table,
        td,
        a {
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table,
        td {
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        img {
            -ms-interpolation-mode: bicubic;
            border: 0;
            height: auto;
            line-height: 100%;
            outline: none;
            text-decoration: none;
        }

        table {
            border-collapse: collapse !important;
        }

        body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            font-family: var(--font-body);
            min-width: 100%;
            background-color: #F7F9FC;
        }

        a {
            color: #0B3B60;
        }

        .email-container {
            width: 600px;
            max-width: 600px;
        }

        .font-brand {
            font-family: var(--font-heading);
        }

        .email-title {
            font-size: 28px;
            line-height: 1.25;
        }

        .email-button a {
            display: inline-block;
        }

        .email-url {
            overflow-wrap: anywhere;
            word-break: break-all;
        }

        @media screen and (max-width: 620px) {
            .email-container {
                width: 100% !important;
            }

            .outer-padding {
                padding: 18px 10px !important;
            }

            .content-padding {
                padding: 30px 22px !important;
            }

            .header-padding {
                padding: 25px 22px !important;
            }

            .email-title {
                font-size: 24px !important;
            }

            .email-button,
            .email-button a {
                display: block !important;
                width: auto !important;
            }

            .email-button a {
                padding: 15px 18px !important;
            }

            .footer-padding {
                padding: 22px !important;
            }
        }
    </style>

    <!--[if mso]>
  <style type="text/css">
    body, table, td, a { font-family: Arial, sans-serif !important; }
  </style>
  <![endif]-->
</head>

<body style="margin:0; padding:0; background-color:#F7F9FC;">
    <!-- Pré-en-tête masqué -->
    <div
        style="display:none; max-height:0; overflow:hidden; mso-hide:all; font-size:1px; line-height:1px; color:#F7F9FC; opacity:0;">
        Vous avez demandé à réinitialiser votre mot de passe pour votre compte Trajet Go. Ce lien expire dans <%= expiresInMinutes %>
            heures.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
        style="background-color:#F7F9FC;">
        <tr>
            <td align="center" class="outer-padding" style="padding:42px 16px;">
                <table role="presentation" class="email-container" width="600" cellpadding="0" cellspacing="0"
                    border="0"
                    style="width:600px; max-width:600px; background-color:#FFFFFF; border-radius:18px; overflow:hidden; box-shadow:0 12px 36px rgba(11,59,96,0.09);">

                    <!-- Bandeau de marque -->
                    <tr>
                        <td class="header-padding"
                            style="padding:30px 40px 34px; background-color:#072a57; background-image:linear-gradient(135deg,#072a57 0%,#364469 100%);">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="left" style="font-family:Inter,'Segoe UI',Arial,sans-serif;">
                                        <div
                                            style="font-size:23px; line-height:1; font-weight:800; letter-spacing:-0.7px; color:#FFFFFF;">
                                            Trajet <span style="color:#f16b03;">Go</span>
                                        </div>
                                        <div
                                            style="padding-top:9px; font-size:10px; line-height:1.4; font-weight:600; letter-spacing:2px; color:#C8DCE9; text-transform:uppercase;">
                                            Voyagez simplement
                                        </div>
                                    </td>
                                    <td align="right" valign="middle">
                                        <span
                                            style="display:inline-block; padding:8px 12px; border:1px solid rgba(255,255,255,0.25); border-radius:20px; color:#E8F2F8; font-family:Inter,'Segoe UI',Arial,sans-serif; font-size:10px; font-weight:700; letter-spacing:1px;">
                                            AUTHENTIFICATION
                                        </span>
                                    </td>
                                </tr>
                            </table>
                            <div
                                style="height:4px; width:54px; margin-top:27px; background-color:#f16b03; border-radius:4px; font-size:1px; line-height:1px;">
                                &nbsp;</div>
                        </td>
                    </tr>

                    <!-- Contenu principal -->
                    <tr>
                        <td class="content-padding font-brand"
                            style="padding:42px 40px 38px; font-family:Inter,'Segoe UI',Arial,sans-serif;">

                            <h1 class="email-title"
                                style="margin:0 0 18px; color:#172033; font-family:Inter,'Segoe UI',Arial,sans-serif; font-size:28px; line-height:1.25; font-weight:800; letter-spacing:-0.8px;">
                                Bonjour <%= fullName || "cher voyageur" %> 👋
                            </h1>

                            <p
                                style="margin:0 0 28px; color:#475467; font-family:Inter,'Segoe UI',Arial,sans-serif; font-size:15px; line-height:1.75;">
                                Vous avez demandé à réinitialiser votre mot de passe.
                                Cliquez sur le bouton ci-dessous pour choisir un nouveau mot de passe.
                            </p>

                            <!-- Bouton CTA -->
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                                style="margin:0 0 28px;">
                                <tr>
                                    <td class="email-button" align="center" bgcolor="#0B3B60"
                                        style="border-radius:10px; background-color:#072a57;">
                                        <a href="<%= resetUrl %>" target="_blank" rel="noopener noreferrer"
                                            style="display:inline-block; padding:16px 28px; border-radius:10px; background-color:#072a57; color:#FFFFFF; font-family:Inter,'Segoe UI',Arial,sans-serif; font-size:14px; line-height:1.2; font-weight:700; text-decoration:none; letter-spacing:0.1px;">
                                            Réinitialiser mon mot de passe&nbsp; →
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <!-- Expiration -->
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="margin:0 0 30px;">
                                <tr>
                                    <td width="4" bgcolor="#F59E0B"
                                        style="width:4px; background-color:#F59E0B; border-radius:4px 0 0 4px;">&nbsp;
                                    </td>
                                    <td
                                        style="padding:14px 16px; background-color:#FFF8E8; border-radius:0 8px 8px 0; color:#805B16; font-family:Inter,'Segoe UI',Arial,sans-serif; font-size:13px; line-height:1.6;">
                                        <strong style="color:#704B0B;">⏱ À savoir :</strong>
                                        ce lien expire dans <strong>
                                            <%= expiresInMinutes %> minutes
                                        </strong>.
                                    </td>
                                </tr>
                            </table>

                            <!-- Lien de secours -->
                            <p
                                style="margin:0 0 9px; color:#667085; font-family:Inter,'Segoe UI',Arial,sans-serif; font-size:12px; line-height:1.6;">
                                Le bouton ne fonctionne pas ? Copiez ce lien et ouvrez-le dans votre navigateur :
                            </p>
                            <p class="email-url"
                                style="margin:0; color:#0B3B60; font-family:Inter,'Segoe UI',Arial,sans-serif; font-size:12px; line-height:1.7;">
                                <a href="<%= resetUrl %>" target="_blank"
                                    style="color:#0B3B60; text-decoration:underline;">
                                    <%= resetUrl %>
                                </a>
                            </p>
                        </td>
                    </tr>

                    <!-- Séparateur -->
                    <tr>
                        <td style="padding:0 40px;">
                            <div style="height:1px; background-color:#E4E7EC; font-size:1px; line-height:1px;">&nbsp;
                            </div>
                        </td>
                    </tr>

                    <!-- Sécurité -->
                    <tr>
                        <td class="content-padding font-brand"
                            style="padding:27px 40px 32px; font-family:Inter,'Segoe UI',Arial,sans-serif;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td valign="top" width="34" style="width:34px; padding-top:1px;">
                                        <div
                                            style="width:26px; height:26px; border-radius:8px; background-color:#E8F2F8; color:#0B3B60; text-align:center; font-size:15px; line-height:26px;">
                                            ✓</div>
                                    </td>
                                    <td>
                                        <p
                                            style="margin:0 0 7px; color:#172033; font-family:Inter,'Segoe UI',Arial,sans-serif; font-size:13px; line-height:1.5; font-weight:700;">
                                            Si vous n'êtes pas à l'origine de cette demande, ignorez cet email.
                                            Votre mot de passe restera inchangé.
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Pied de page -->
                    <tr>
                        <td class="footer-padding" align="center"
                            style="padding:24px 40px; background-color:#F7F9FC; border-top:1px solid #E4E7EC; font-family:Inter,'Segoe UI',Arial,sans-serif;">
                            <p style="margin:0 0 7px; color:#0B3B60; font-size:12px; line-height:1.5; font-weight:700;">
                                Trajet Go — Voyagez simplement.
                            </p>
                            <p style="margin:0 0 5px; color:#98A2B3; font-size:11px; line-height:1.6;">
                                © <%= new Date().getFullYear() %> Trajet Go · Abidjan, Côte d'Ivoire
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>